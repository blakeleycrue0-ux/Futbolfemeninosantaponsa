# Copia este fichero a .env para desarrollo local con `netlify dev`.
# En producción, define estas variables en Netlify (Site settings > Environment variables).

# --- Cliente público (web + inject-config.js) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxx.anon.key

# --- Solo servidor (Netlify Functions, NUNCA exponer en el cliente) ---
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx.service.role.key

# --- Email transaccional (Gmail SMTP vía Nodemailer) ---
# GMAIL_APP_PASSWORD es una "contraseña de aplicación" de Google (no la
# contraseña normal de la cuenta) — se genera en myaccount.google.com/apppasswords
# con la verificación en dos pasos activada.
GMAIL_USER=tucuenta@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- WhatsApp (Meta WhatsApp Business Platform / Cloud API) ---
# Segundo canal de aviso al aceptar una plaza (netlify/functions/confirm-inscripcion.js
# + netlify/functions/lib/whatsapp.js). Si estas dos variables no están
# definidas, el envío funciona en modo simulado (no manda nada de verdad).
WHATSAPP_ACCESS_TOKEN=xxxxx
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxx
# Opcionales — solo si cambia el nombre de la plantilla aprobada en Meta
# Business Manager, o si Meta retira la versión de API por defecto (v21.0).
# WHATSAPP_TEMPLATE_NAME=plaza_aceptada
# WHATSAPP_API_VERSION=v21.0

# --- Scraping FFIB ---
# cod_primaria del grupo/categoría del primer equipo en ffib.es.
# Se localiza navegando manualmente ffib.es -> Competiciones -> el grupo
# correcto del Femenino Santa Ponsa -> copiar el valor de la URL.
FFIB_COMPETITION_ID=1234567

# uuid del equipo en la tabla `teams` de Supabase (el "Primer Equipo")
FFIB_TEAM_ID=00000000-0000-0000-0000-000000000000

# Opcionales — solo si la plantilla de URL por defecto en ffib-sync.js
# deja de coincidir con la estructura real de ffib.es
# FFIB_JORNADA_URL_TEMPLATE=https://www.ffib.es/Fed/NPcd/NFG_CmpJornada?cod_primaria=...&cod_competicion={cod}
# FFIB_CLASIFICACION_URL_TEMPLATE=https://www.ffib.es/Fed/NPcd/NFG_CmpClasificacion?cod_primaria=...&cod_competicion={cod}

# --- Stripe (socios, abonos y entradas) ---
# Claves de tu cuenta de Stripe (dashboard.stripe.com/apikeys). Igual que el
# resto de secretos de este fichero, en Netlify se definen en Site settings >
# Environment variables, nunca en el repo.
STRIPE_SECRET_KEY=sk_live_xxxxx
# Pública — sí puede ir en el cliente, pero hoy no se usa en el navegador
# (el checkout se abre con la URL que devuelve create-checkout-session.js).
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
# Se obtiene al crear el endpoint del webhook en el dashboard de Stripe
# (Developers > Webhooks > Add endpoint), apuntando a
# https://ffsp.info/.netlify/functions/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# --- Apple Wallet (tarjeta de socio / entrada en el iPhone) ---
# Requiere cuenta de Apple Developer Program. Todos en base64 (un .pem o
# .p12 pasado por `base64 -i fichero.pem`), para poder pegarlos en una sola
# línea de variable de entorno de Netlify.
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_PASS_CERT_BASE64=
APPLE_PASS_KEY_BASE64=
APPLE_PASS_KEY_PASSWORD=
APPLE_WWDR_CERT_BASE64=
