# Copia este fichero a .env para desarrollo local con `netlify dev`.
# En producción, define estas variables en Netlify (Site settings > Environment variables).

# --- Cliente público (web + inject-config.js) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxx.anon.key

# --- Solo servidor (Netlify Functions, NUNCA exponer en el cliente) ---
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx.service.role.key

# --- Scraping FFIB ---
# cod_primaria del grupo/categoría del primer equipo en ffib.es.
# Se localiza navegando manualmente ffib.es -> Competiciones -> el grupo
# correcto del Femenino Santa Ponsa -> copiar el valor de la URL.
FFIB_COMPETITION_ID=1234567

# uuid del equipo en la tabla `teams` de Supabase (el "Primer Equipo")
FFIB_TEAM_ID=00000000-0000-0000-0000-000000000000

# Opcionales — solo si la plantilla de URL por defecto en ffib-sync.js
# deja de coincidir con la estructura real de ffib.es
# FFIB_JORNADA_URL_TEMPLATE=https://www.ffib.es/Fed/NPcd/NFG_CmpJornada?cod_primaria=...&cod_competicion={cod}
# FFIB_CLASIFICACION_URL_TEMPLATE=https://www.ffib.es/Fed/NPcd/NFG_CmpClasificacion?cod_primaria=...&cod_competicion={cod}
